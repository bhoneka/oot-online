+        // anything moved by real-time clocks (another player's stand-in) drifted against the game's own animation
+        static int one = -1; if (one < 0) { const char *e = getenv("DM_FSTEP_ONE"); one = e && atoi(e); if (one) LOG("[nvn] frame step: every frame steps %d vsync(s) of game time (DM_FSTEP_ONE)", kmin); }
+        if (one && !fixed) n = kmin;
