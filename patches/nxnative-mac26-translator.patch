diff --git a/dm/gfx/tools/dmsh_chain.py b/dm/gfx/tools/dmsh_chain.py
index 05b7c66b..3eaa7315 100644
--- a/dm/gfx/tools/dmsh_chain.py
+++ b/dm/gfx/tools/dmsh_chain.py
@@ -28,6 +28,12 @@ LOCK = os.path.join(HERE, 'dmsh_chain.lock'); HEADER = os.path.join(GFX, 'nvn/dm
 STAMP = 'inputs.tsv'   # in the library directory b-<V>/
 # the translator defaults to the in-repo build that matches the lock file (dm/tools/native_tools.sh; a rebuild has another fingerprint)
 XLATE_DIR = os.path.dirname(os.environ.get('XLATE', os.path.join(HERE, 'dmsh_xlate_bin/dmsh_xlate')))
+def xlate_cmd(path):   # local (oot-mac): the committed translator was linked with the macOS 27.2 SDK and its arm64 half calls pipe2(), which macOS 26 lacks (a null jump at start).
+    # Its x86_64 half is the same program (same --source-sha) and runs under Rosetta. DM_XLATE_X86=1/0 forces it on/off; default: on below macOS 27
+    import platform
+    want = os.environ.get('DM_XLATE_X86')
+    if want is None: want = '1' if int((platform.mac_ver()[0] or '99').split('.')[0]) < 27 else '0'
+    return ['arch', '-x86_64', str(path)] if want == '1' else [str(path)]
 # spirv-cross likewise: the in-repo build (spirv_cross_bin/build.sh, a pinned upstream commit) that matches the lock file, not the one on PATH, so every Mac converts with the same build
 SPIRV_CROSS = os.environ.get('SPIRV_CROSS', os.path.join(HERE, 'spirv_cross_bin/spirv-cross'))
 
diff --git a/dm/gfx/tools/tool_lock.py b/dm/gfx/tools/tool_lock.py
index 25643f71..b715d218 100755
--- a/dm/gfx/tools/tool_lock.py
+++ b/dm/gfx/tools/tool_lock.py
@@ -26,7 +26,7 @@ NO_RUN = 'does not run'
 def xlate_embedded():
     """The source digest the translator embeds (dmsh_xlate --source-sha), or 'does not run (<its first error line>)', so a translator that cannot start (missing, not executable, a download
     quarantined by macOS) is named as such rather than read as an empty digest and a stale translator"""
-    try: r = subprocess.run([os.path.join(XLATE_DIR, 'dmsh_xlate'), '--source-sha'], capture_output=True, text=True, errors='replace', timeout=60)
+    try: r = subprocess.run([*__import__('dmsh_chain').xlate_cmd(os.path.join(XLATE_DIR, 'dmsh_xlate')), '--source-sha'], capture_output=True, text=True, errors='replace', timeout=60)
     except (OSError, subprocess.SubprocessError) as e: return f'{NO_RUN} ({e})'
     if r.returncode == 0 and r.stdout.strip(): return r.stdout.strip()
     return '%s (%s)' % (NO_RUN, (r.stderr.strip().splitlines() or r.stdout.strip().splitlines() or [f'exit code {r.returncode}'])[0])
