diff --git a/dm/host/mp_game.h b/dm/host/mp_game.h
new file mode 100644
index 00000000..f6190b67
--- /dev/null
+++ b/dm/host/mp_game.h
@@ -0,0 +1,37 @@
+// OoT Online: what the multiplayer module needs from one game. Each function has a weak no-op default in hle_mp.c;
+// a game's file (games/oot_v131072.c) gives the real ones once its addresses are known. Two threads call in:
+//  - the present thread, once a presented frame (reads only: Link's state, the camera);
+//  - the game's own thread, from player 1's input read at the start of its frame (writes: damage, respawn, the stand-ins,
+//    the lobby window), so the game never sees its objects change under it mid-update; game code may be called there.
+#pragma once
+#include "mp_net.h"
+
+int  mp_game_read_local(mp_local_state *st);            // present thread: 1 = Link is in the world and st holds him
+int  mp_game_project(float x, float y, float z, float *sx, float *sy);   // present thread: world -> screen 0..1 (top left); 1 = in front of the camera
+uint32_t mp_game_build(void);                           // first 4 bytes of main's build ID (for HELLO), 0 = unknown
+
+// Two ticks, both on the game's frame thread. The world tick runs from player 1's input read (the game's own stack: game code
+// that locks may be called) while the player is in control; the game stops reading player 1 there while one of its menus is open.
+// The UI tick runs from the frame gate every frame, menus or not, on nxnative's gate stack: only calls that never make a system
+// call (no lock, no clock read) may run there. World tick, in this order each frame:
+void mp_game_apply_damage(int quarter_hearts, uint16_t attacker, int kind);
+void mp_game_respawn(uint32_t scene, float x, float y, float z, uint16_t yaw, int own_spot);   // own_spot: the game's last safe spot
+int  mp_game_set_outfit(int outfit);                    // 1 = on Link now (0: no Link yet, or child Link)
+void mp_game_update_puppets(const mp_remote *others, int n);   // place / animate / add / remove the stand-ins
+void mp_game_shot_fx(uint16_t shooter, float x, float y, float z, float dx, float dy, float dz, int kind);
+int  mp_game_take_local_events(void);
+// The lobby as the game's own system window over its dimmed background (game thread). want: shown or not; text: the window's
+// sentence; labels: the three buttons (Play, Tunic, Name). Returns 0 when the game's window cannot be used now (no Link in the
+// world, the screens not there: the caller shows its own page), 1 opening, 2 open, 3 closing. *decided: the button the player
+// chose this frame (0..2), else -1; the window closes itself after a choice (ask again to show it again)
+void mp_game_notice(const char *line);                  // any thread: a one-line notice in the game's own info bar (queued, one at a time)
+int  mp_game_go_to_field(void);                         // world tick: take Link to the shared place (Hyrule Field) unless he is there; 1 = under way or there, 0 = not now (try again)
+int  mp_game_ready(void);                               // 1 = this build is known: the game's own window is the lobby (else the drawn page)
+void mp_game_ui_tick(void);                             // the frame gate (no calls that can make a system call): the notices
+void mp_game_world_prep(void);                          // the world tick: what the UI side asked for that can lock (loading a screen)
+int  mp_game_lobby(int want, const char *text, const char *const labels[3], int *decided);
+// Observation gates in the game's code (the game thread; regs = x0..x30 as saved there, a write to x0..x28 takes effect):
+void mp_game_gate_event(uint64_t *regs);       // EventMgr::requestEvent's entry: may refuse a request (story cutscenes)
+void mp_game_gate_gameover(uint64_t *regs);    // PlayerComponent::calc's game-over check
+void mp_game_gate_shoot(uint64_t *regs);       // a ShooterComponent fires (x0 the shooter)                   // the game's side of shots, hits, deaths: it calls mp_send_* itself; returns how many
+
diff --git a/dm/host/mp_net.h b/dm/host/mp_net.h
new file mode 100644
index 00000000..a6d1f392
--- /dev/null
+++ b/dm/host/mp_net.h
@@ -0,0 +1,91 @@
+// OoT Online: the game side's network client (C, no game knowledge). It speaks server/protocol.js's protocol v1 on a
+// thread of its own; the game thread hands it Link's state once a frame and takes back the other players (interpolated
+// for the moment it draws), the chat and the events (damage, respawn, kill feed, ...).
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+
+#define MP_PROTOCOL 1
+#define MP_MAX_NEAR 40
+#define MP_NAME_MAX 25
+#define MP_CHAT_MAX 161
+#define MP_NOBODY 0xffff
+
+enum { MP_KIND_PLAYER = 0, MP_KIND_BOT = 1 };
+enum { MP_PF_AIM = 1, MP_PF_SWIM = 2, MP_PF_CLIMB = 4, MP_PF_AIR = 8, MP_PF_GUARD = 16, MP_PF_DEAD = 32, MP_PF_INVULN = 64, MP_PF_CHATTING = 128 };
+enum { MP_EQ_CHILD = 1 };   // the state's equip byte (the server passes it through): bit 0 young Link
+enum { MP_YOU_DEAD = 1, MP_YOU_INVULN = 2, MP_YOU_MUTED = 4 };
+enum { MP_CEV_CHAT = 1, MP_CEV_SHOT = 2, MP_CEV_HIT = 3, MP_CEV_DIED = 4, MP_CEV_OUTFIT = 5, MP_CEV_RESPAWN_REQ = 6 };
+enum { MP_SEV_CHAT = 1, MP_SEV_DAMAGE = 2, MP_SEV_KILLFEED = 3, MP_SEV_RESPAWN = 4, MP_SEV_HITCONFIRM = 5, MP_SEV_STATS = 6, MP_SEV_KICK = 7 };
+enum { MP_EV_SHOT = 100 };   // someone's arrow near us (from the snapshot's shot list, not a server event)
+enum { MP_CHAN_ALL = 0, MP_CHAN_SYSTEM = 1, MP_CHAN_WHISPER = 2 };
+enum { MP_HIT_ARROW = 0, MP_HIT_FIRE_ARROW = 1, MP_HIT_ICE_ARROW = 2, MP_HIT_LIGHT_ARROW = 3, MP_HIT_MELEE = 4, MP_HIT_OTHER = 5 };
+enum { MP_HOW_PLAYER = 0, MP_HOW_WORLD = 1 };
+// Connection states (mp_status)
+enum { MP_OFF = 0, MP_RESOLVING, MP_CONNECTING, MP_ONLINE, MP_LOST, MP_REJECTED };
+
+typedef struct {
+    uint32_t scene;
+    float x, y, z;
+    uint16_t yaw, anim;
+    uint8_t flags, hp, max_hp, equip;   // hp in quarter hearts; equip: MP_EQ_*
+} mp_local_state;
+
+typedef struct {
+    uint16_t id;
+    float x, y, z;
+    uint16_t yaw, anim;
+    uint8_t flags, hp_pct, outfit, equip;
+    char name[MP_NAME_MAX];             // "" until the server said it
+} mp_remote;
+
+typedef struct {
+    int type;                           // MP_SEV_*
+    union {
+        struct { uint16_t from; uint8_t chan; char name[MP_NAME_MAX]; char text[MP_CHAT_MAX]; } chat;
+        struct { uint16_t attacker; uint8_t quarter_hearts, kind; } damage;
+        struct { uint16_t killer, victim; uint8_t how; char killer_name[MP_NAME_MAX], victim_name[MP_NAME_MAX]; } killfeed;
+        struct { uint32_t scene; float x, y, z; uint16_t yaw, invuln_ms; } respawn;   // x NaN: your own last safe spot
+        struct { uint16_t target; uint8_t quarter_hearts, killed; } hitconfirm;
+        struct { uint16_t kills, deaths, streak, best, all_kills, all_deaths, all_best; } stats;   // this visit, then all time
+        struct { char reason[MP_CHAT_MAX]; } kick;
+        struct { uint16_t shooter; float x, y, z, dx, dy, dz; uint8_t kind; } shot;
+    } u;
+} mp_event;
+
+typedef struct {
+    int state;                          // MP_OFF ... MP_REJECTED
+    uint16_t id;                        // ours, once online
+    uint16_t online;                    // players on the server
+    uint8_t you_flags;
+    int ping_ms;
+    char name[MP_NAME_MAX];             // ours, as the server made it unique
+    char detail[MP_CHAT_MAX];           // why not online (reject reason, resolver error)
+} mp_status_t;
+
+typedef struct {
+    const char *server;                 // "host[:port]" (default port 4697)
+    const char *name;
+    int outfit;
+    const char *code;                   // room code, "" = none
+    uint32_t build;                     // first 4 bytes of the game's main build ID (0 = don't say)
+    uint32_t player_key;                // random per install, never 0
+    int kind;                           // MP_KIND_PLAYER
+    double interp_delay_ms;             // how far behind the newest snapshot others are drawn (default 2 ticks + 15 ms)
+} mp_config;
+
+int  mp_start(const mp_config *cfg);    // starts the network thread; 0 = ok
+void mp_stop(void);                     // BYE, then the thread ends
+void mp_set_local(const mp_local_state *st);                 // the game thread, once a frame
+int  mp_get_remote(mp_remote *out, int max);                 // the others, interpolated for now (nearest first); returns how many
+int  mp_poll_event(mp_event *ev);                            // 1 = an event was taken (call until 0, once a frame)
+void mp_send_chat(const char *text);
+void mp_send_shot(float x, float y, float z, float dx, float dy, float dz, int kind);
+void mp_send_hit(uint16_t target, int kind);
+void mp_send_died(uint16_t killer, int how);
+void mp_send_outfit(int outfit);
+void mp_request_respawn(void);
+void mp_status(mp_status_t *out);
+void mp_rename(const char *name);       // joins again under this name (same player key: the server replaces the old session)
+void mp_set_outfit(int outfit);         // the outfit HELLO carries from now on (mp_send_outfit tells the server now)
+const char *mp_name_of(uint16_t id);    // "" when unknown (thread-safe copy kept per id)
diff --git a/dm/host/mp_overlay_mac.m b/dm/host/mp_overlay_mac.m
new file mode 100644
index 00000000..c93a810f
--- /dev/null
+++ b/dm/host/mp_overlay_mac.m
@@ -0,0 +1,387 @@
+// OoT Online: the Mac overlay over the game window. The lobby page (outfit, your card, PLAY), the chat log (bottom left)
+// with its input box, the kill feed (top right), the connection pill (top left), the hit marker, the big centre banner
+// and name tags over the other players. AppKit views on top of the game's CAMetalLayer view; the mouse goes through
+// them. Everything here runs on the main thread; mp_ui_* calls from other threads only fill the shared state under a lock.
+#import <AppKit/AppKit.h>
+#import <CoreText/CoreText.h>
+#include <os/lock.h>
+#include <string.h>
+#include "mp_ui.h"
+#include "mp_net.h"
+
+void (*mp_ui_on_send)(const char *text);
+void (*mp_ui_on_rename)(const char *name);
+
+typedef struct { char name[25]; char text[200]; int kind, outfit; double t; } Line;
+static os_unfair_lock L = OS_UNFAIR_LOCK_INIT;
+static Line g_chat[64]; static int g_chat_n;              // newest last
+typedef struct { char k[25], v[25]; double t; } Feed;
+static Feed g_feed[6]; static int g_feed_n;
+static double g_hit_t = -1e9; static int g_hit_killed;
+static char g_banner[200]; static double g_banner_until;
+static int g_state, g_online, g_ping; static char g_detail[161];
+static mp_ui_tag g_tags[MP_MAX_NEAR]; static int g_tags_n;
+static mp_ui_lobby_t g_lobby; static double g_lobby_press_t = -1e9; static int g_lobby_press; static double g_lobby_since;
+static int g_editing, g_rename;                           // main thread
+static char g_rename_req[25]; static int g_rename_pending; // any thread -> main
+static NSWindow *g_win; static NSTextField *g_field; static NSView *g_overlay;
+static void (*g_release)(void), (*g_resume)(void);
+
+static double tnow(void) { return CACurrentMediaTime(); }
+
+// The game's own typefaces (Font2/Scalable in its RomFS: Cetra Display Pro for titles, Clarimo UD PE for menus, NinDev-Number for
+// figures, External for the controller's buttons), taken from the player's own game by tools/game_fonts.py into
+// $DM_MP_FONTS (default $DM_ROOT/oot_online/fonts). Without them the system font stands in.
+enum { F_TITLE, F_DISPLAY, F_LABEL, F_BODY, F_LIGHT, F_NUMBER, F_ICON };
+static const char *FONT_PS[] = { "CetraDisplayPro-Medium", "CetraDisplayPro-Regular", "ClarimoUDPE-DemiBold", "ClarimoUDPE-Regular", "ClarimoUDPE-Light", "NinDevNumber-Lining", "External" };
+static int g_fonts_ok;
+static void load_game_fonts(void) {
+    const char *d = getenv("DM_MP_FONTS"); char buf[1024];
+    if (!d || !*d) { const char *root = getenv("DM_ROOT"); snprintf(buf, sizeof buf, "%s/oot_online/fonts", root && *root ? root : "."); d = buf; }
+    NSString *dir = @(d); int n = 0;
+    for (NSString *f in [NSFileManager.defaultManager contentsOfDirectoryAtPath:dir error:nil])
+        if ([f hasSuffix:@".otf"] || [f hasSuffix:@".ttf"]) n += CTFontManagerRegisterFontsForURL((__bridge CFURLRef)[NSURL fileURLWithPath:[dir stringByAppendingPathComponent:f]], kCTFontManagerScopeProcess, NULL) ? 1 : 0;
+    g_fonts_ok = [NSFont fontWithName:@"ClarimoUDPE-Regular" size:12] != nil;
+    NSLog(@"OoT Online: %d of the game's fonts from %@%@", n, dir, g_fonts_ok ? @"" : @" (none: the system font stands in)");
+}
+static NSFont *gfont(int role, CGFloat size) {
+    NSFont *f = [NSFont fontWithName:@(FONT_PS[role]) size:size];
+    if (f) return f;
+    NSFontWeight w = role == F_TITLE || role == F_LABEL ? NSFontWeightBold : role == F_LIGHT ? NSFontWeightLight : NSFontWeightRegular;
+    return role == F_NUMBER ? [NSFont monospacedDigitSystemFontOfSize:size weight:NSFontWeightBold] : [NSFont systemFontOfSize:size weight:w];
+}
+static NSString *icon(unichar c) { return [NSString stringWithCharacters:&c length:1]; }   // External: E040 A, E041 B, E042 X, E043 Y, E049 D-pad
+static void copy(char *dst, size_t cap, const char *s) { snprintf(dst, cap, "%s", s ? s : ""); }
+
+void mp_ui_chat(int kind, const char *name, int outfit, const char *text) {
+    os_unfair_lock_lock(&L);
+    if (g_chat_n == 64) { memmove(g_chat, g_chat + 1, sizeof(Line) * 63); g_chat_n--; }
+    Line *l = &g_chat[g_chat_n++]; copy(l->name, sizeof l->name, name); copy(l->text, sizeof l->text, text); l->kind = kind; l->outfit = outfit; l->t = tnow();
+    os_unfair_lock_unlock(&L);
+}
+void mp_ui_feed(const char *killer, const char *victim) {
+    os_unfair_lock_lock(&L);
+    if (g_feed_n == 6) { memmove(g_feed, g_feed + 1, sizeof(Feed) * 5); g_feed_n--; }
+    Feed *f = &g_feed[g_feed_n++]; copy(f->k, sizeof f->k, killer); copy(f->v, sizeof f->v, victim); f->t = tnow();
+    os_unfair_lock_unlock(&L);
+}
+void mp_ui_hitmarker(int killed) { os_unfair_lock_lock(&L); g_hit_t = tnow(); g_hit_killed = killed; os_unfair_lock_unlock(&L); }
+void mp_ui_banner(const char *text, double seconds) { os_unfair_lock_lock(&L); copy(g_banner, sizeof g_banner, text); g_banner_until = tnow() + seconds; os_unfair_lock_unlock(&L); }
+void mp_ui_status(int state, int online, const char *detail, int ping_ms) {
+    os_unfair_lock_lock(&L); g_state = state; g_online = online; g_ping = ping_ms; copy(g_detail, sizeof g_detail, detail); os_unfair_lock_unlock(&L);
+}
+void mp_ui_tags(const mp_ui_tag *tags, int n) {
+    os_unfair_lock_lock(&L); if (n > MP_MAX_NEAR) n = MP_MAX_NEAR; memcpy(g_tags, tags, sizeof(mp_ui_tag) * n); g_tags_n = n; os_unfair_lock_unlock(&L);
+}
+void mp_ui_lobby(const mp_ui_lobby_t *l) {
+    os_unfair_lock_lock(&L);
+    if (l->shown && !g_lobby.shown) g_lobby_since = tnow();
+    if (l->pressed) { g_lobby_press = l->pressed; g_lobby_press_t = tnow(); }
+    g_lobby = *l; g_lobby.pressed = 0;
+    os_unfair_lock_unlock(&L);
+}
+int mp_ui_editing(void) { return g_editing; }
+
+// ---------------------------------------------------------------- drawing helpers
+static NSColor *rgb(double r, double g, double b) { return [NSColor colorWithSRGBRed:r green:g blue:b alpha:1]; }
+static NSColor *outfit_color(int o) { return o == 1 ? rgb(0.96, 0.45, 0.36) : o == 2 ? rgb(0.42, 0.68, 1.00) : rgb(0.47, 0.86, 0.45); }
+static NSColor *outfit_deep(int o) { return o == 1 ? rgb(0.62, 0.16, 0.12) : o == 2 ? rgb(0.10, 0.30, 0.66) : rgb(0.13, 0.45, 0.17); }
+static const char *OUTFIT_NAME[] = { "KOKIRI TUNIC", "GORON TUNIC", "ZORA TUNIC" };
+static const char *OUTFIT_LINE[] = { "The forest's green. Where it all began.", "Woven for Death Mountain's heat.", "Cut for the waters of Zora's Domain." };
+static NSShadow *text_shadow(void) {
+    static NSShadow *s; if (!s) { s = [NSShadow new]; s.shadowColor = [NSColor colorWithWhite:0 alpha:0.85]; s.shadowBlurRadius = 3; s.shadowOffset = NSMakeSize(0, -1); }
+    return s;
+}
+static NSDictionary *fattrs(int role, CGFloat size, NSColor *c, CGFloat alpha) {
+    return @{ NSFontAttributeName: gfont(role, size), NSForegroundColorAttributeName: [c colorWithAlphaComponent:alpha * c.alphaComponent], NSShadowAttributeName: text_shadow() };
+}
+static NSDictionary *attrs(CGFloat size, NSFontWeight w, NSColor *c, CGFloat alpha) {   // the old weights map onto the game's faces
