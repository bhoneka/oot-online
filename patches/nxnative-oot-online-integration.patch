+    if (g_tr.st != prev) MP_GAME_LOG("travel: %s", g_tr.st == 2 ? "the carrier event plays" : g_tr.st == 3 ? "loading the area" : g_tr.st == 4 ? "arrived, settling" : g_tr.st == 5 ? "done" : "failed (reservation cleared)");
+}
