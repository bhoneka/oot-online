+# dmsh_rtc_bin/dmsh_rtc, arm64, for the host's minimum macOS (dm/mac/min_os.mk). Needs Xcode or the Command Line Tools: it is built where
+# those are (a developer's Mac, CI) and shipped prebuilt to a Mac without them.
+set -e
+cd "$(dirname "$0")"
+min=$(sed -n 's/^MACOS_MIN := //p' ../../mac/min_os.mk)
+mkdir -p dmsh_rtc_bin
+xcrun clang -fobjc-arc -O2 -Wall -Wextra -arch arm64 "-mmacosx-version-min=$min" -framework Foundation -framework Metal dmsh_rtc.m -o dmsh_rtc_bin/dmsh_rtc
