diff --git a/dm/mac/prebuild.py b/dm/mac/prebuild.py
new file mode 100644
index 00000000..c130d192
--- /dev/null
+++ b/dm/mac/prebuild.py
@@ -0,0 +1,44 @@
+#!/usr/bin/env python3
+# The native parts of a Mac app, built here (Xcode or the Command Line Tools) for a Mac that has neither: the Mac host for a game profile, the app's launcher and dmsh_rtc (the shaders'
+# Metal compile through macOS's run-time compiler, dm/gfx/tools/dmsh_rtc.m). The NSP script's --no-xcode takes the folder this writes (--prebuilt), checks the host against the profile and the
+# chain version it packs (build_ipa_from_nsp.py prebuilt_manifest, prebuilt_host) and packs these instead of compiling them. manifest.json records what they were built from: the profile's
+# game_profile.h, the chain version, the minimum macOS, the commit, and each file's sha256. Nothing in it comes from a game's files: the profile is the repository's.
+# Usage: prebuild.py <game title ID> <out folder>     (run from a checkout; the chain header is rewritten first when the tree's chain files changed: dmsh_chain.py --header)
+import hashlib, json, os, shutil, subprocess, sys, tempfile
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent; REPO = HERE.parents[1]
+sys.path.insert(0, str(HERE)); import pack_app
+
+
+def sha(p): return hashlib.sha256(Path(p).read_bytes()).hexdigest()
+
+
+def main(game, out):
+    out = Path(out).resolve(); out.mkdir(parents=True, exist_ok=True)
+    py = sys.executable
+    subprocess.run([py, REPO / 'dm/gfx/tools/dmsh_chain.py', '--header'], check=True)
+    chain = subprocess.run([py, REPO / 'dm/gfx/tools/dmsh_chain.py'], check=True, capture_output=True, text=True).stdout.strip()
+    host = REPO / 'dm/host'
+    subprocess.run(['make', '-s', f'GAME={game}', f'gen/{game}/game_profile.h', 'gen/vpx/libvpx.a', 'gen/dav1d/libdav1d.a', 'host_msl'], cwd=host, check=True)
+    subprocess.run(['make', '-s', f'GAME={game}', 'dmhost'], cwd=host, check=True)
+    shutil.copyfile(host / 'dmhost', out / 'dmhost'); os.chmod(out / 'dmhost', 0o755)
+    minos = pack_app.min_os(out / 'dmhost')
+    xcrun = lambda *a: subprocess.run(['xcrun', *a], check=True, capture_output=True, text=True).stdout.strip()
+    with tempfile.TemporaryDirectory() as t:   # build_launcher works inside the app it builds for (its temporary folder beside the app)
+        exe = Path(t) / 'launcher.app/Contents/MacOS/launcher'; exe.parent.mkdir(parents=True)
+        pack_app.build_launcher(exe, minos, Path(xcrun('--find', 'clang')).resolve(), Path(xcrun('--find', 'swiftc')), Path(xcrun('--sdk', 'macosx', '--show-sdk-path')).resolve())
+        shutil.copyfile(exe, out / 'launcher'); os.chmod(out / 'launcher', 0o755)
+    subprocess.run(['sh', REPO / 'dm/gfx/tools/dmsh_rtc.sh'], check=True)
+    shutil.copyfile(REPO / 'dm/gfx/tools/dmsh_rtc_bin/dmsh_rtc', out / 'dmsh_rtc'); os.chmod(out / 'dmsh_rtc', 0o755)
+    commit = os.environ.get('DM_SOURCE_COMMIT') or subprocess.run(['git', '-C', REPO, 'rev-parse', '--short=12', 'HEAD'], capture_output=True, text=True).stdout.strip() or None
+    files = ('dmhost', 'launcher', 'dmsh_rtc')
+    manifest = {'format': 1, 'game': game, 'chain': chain, 'minos': minos, 'commit': commit, 'profile_header': (host / f'gen/{game}/game_profile.h').read_text(),
+                'files': {f: sha(out / f) for f in files}, 'sdk': xcrun('--sdk', 'macosx', '--show-sdk-version'), 'clang': xcrun('clang', '--version').splitlines()[0]}
+    (out / 'manifest.json').write_text(json.dumps(manifest, indent=1) + '\n')
+    print(f'prebuilt for {game}, chain {chain}, macOS {minos}+: {out}')
+
+
+if __name__ == '__main__':
+    if len(sys.argv) != 3: sys.exit('usage: prebuild.py <game title ID> <out folder>')
+    main(*sys.argv[1:])
