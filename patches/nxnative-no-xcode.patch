diff --git a/dm/gfx/tools/dmsh_rtc.m b/dm/gfx/tools/dmsh_rtc.m
new file mode 100644
index 00000000..d9ecd465
--- /dev/null
+++ b/dm/gfx/tools/dmsh_rtc.m
@@ -0,0 +1,139 @@
+// dmsh_rtc: the shader libraries' Metal compile on a Mac without Xcode. macOS's own run-time compiler (MTLCompilerService, the
+// compiler every Metal app uses for newLibraryWithSource) takes the offline build's options as compiler arguments, and the
+// library it makes is written to a file (the library's serializeToURL); dmsh_rtc.py turns that file into the layout Xcode's
+// metallib writes, so the host and the tools that read libraries (dmsh_side.cut) see what an Xcode build gives them.
+// Both calls are Metal's own but not in its headers (MTLCompileOptions additionalCompilerArguments, _MTLLibrary
+// serializeToURL:error:): --check fails when a macOS lacks them, and the NSP script stops there with that message.
+// The options are the offline compile's (dmsh_build.py MAC_METAL): -O1, -fwrapv, the bracket depth of Ocarina of Time's
+// largest compute shaders, invariance (MTLCompileOptions preserveInvariance, the driver's -fpreserve-invariance), and no value
+// names (the driver's default, which the front end's arguments do not get).
+// Built by dmsh_rtc.sh (clang, Foundation and Metal); shipped prebuilt where no compiler is (the OoT Online installer).
+// usage: dmsh_rtc --version          one line: macOS's version and build and the Metal front end's version (the compiler's identity)
+//        dmsh_rtc --arch             this Mac's GPU architecture as Metal names it (MTLDevice.architecture, e.g. applegpu_g17s)
+//        dmsh_rtc --check            compile and write a test library; exit 0 when this Mac can, else the reason on standard error
+//        dmsh_rtc --serve [jobs]     compile requests from standard input, one a line: <id> TAB <MSL file> TAB <library file to write>;
+//                                    each answered on standard output when done, in any order: <id> TAB ok TAB <ms>, or
+//                                    <id> TAB error TAB <the compiler's message on one line>. jobs: compiles at once (default: the cores)
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <objc/message.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static NSString *const ARGS = @"-O1 -fwrapv -fbracket-depth 1024 -discard-value-names";
+
+static MTLCompileOptions *options(void) {
+    MTLCompileOptions *o = [MTLCompileOptions new];
+    o.preserveInvariance = YES;
+    [o setValue:ARGS forKey:@"additionalCompilerArguments"];
+    return o;
+}
+
+static BOOL has_calls(void) {   // asked of an instance: MTLCompileOptions only declares its properties, a private subclass implements them
+    return [[MTLCompileOptions new] respondsToSelector:@selector(setAdditionalCompilerArguments:)] &&
+           [NSClassFromString(@"_MTLLibrary") instancesRespondToSelector:@selector(serializeToURL:error:)];
+}
+
+// One library: the source compiled and written to out. A compile cut off by the compiler service stopping (it is restarted)
+// is tried again. Returns nil, or the reason it failed.
+static NSString *compile_file(id<MTLDevice> dev, MTLCompileOptions *opts, NSString *src, NSString *out) {
+    for (int attempt = 1;; attempt++) @autoreleasepool {
+        NSError *e = nil;
+        id<MTLLibrary> lib = [dev newLibraryWithSource:src options:opts error:&e];
+        if (lib) {
+            if (![lib respondsToSelector:@selector(serializeToURL:error:)]) return @"this macOS cannot write a library it compiled (no serializeToURL)";
+            BOOL ok = ((BOOL (*)(id, SEL, NSURL *, NSError **))objc_msgSend)(lib, @selector(serializeToURL:error:), [NSURL fileURLWithPath:out], &e);
+            return ok ? nil : [NSString stringWithFormat:@"the library was compiled but not written: %@", e.localizedDescription ?: @"no reason given"];
+        }
+        NSString *why = e.localizedDescription ?: @"the compiler gave no reason";
+        if (attempt < 4 && [why containsString:@"XPC_ERROR_CONNECTION_INTERRUPTED"]) { usleep((useconds_t)attempt * 200000); continue; }
+        return why;
+    }
+}
+
+static NSString *one_line(NSString *s) {   // the compiler's errors with the two lines after each (the source line and the caret), not its warnings
+    NSArray<NSString *> *lines = [s componentsSeparatedByCharactersInSet:NSCharacterSet.newlineCharacterSet];
+    NSMutableArray<NSString *> *keep = [NSMutableArray array];
+    for (NSUInteger i = 0; i < lines.count; i++)
+        if ([lines[i] containsString:@"error:"]) for (NSUInteger j = i; j < MIN(i + 3, lines.count); j++) [keep addObject:lines[j]];
+    s = [(keep.count ? keep : lines) componentsJoinedByString:@" | "];
+    s = [s stringByReplacingOccurrencesOfString:@"\t" withString:@" "];
+    return s.length > 4000 ? [s substringToIndex:4000] : s;
+}
+
+static NSString *TEST = @"#include <metal_stdlib>\nusing namespace metal;\n"
+    "struct V { float4 p [[position, invariant]]; };\n"
+    "vertex V dmsh_rtc_v(uint i [[vertex_id]], constant int *b [[buffer(0)]]) { int a = b[i] * 65536; V v; v.p = float4(float((a >> 31) << 16 | int(uint(a) >> 16))); return v; }\n"
+    "fragment float4 dmsh_rtc_f(V in [[stage_in]]) { return in.p; }\n";
+
+// The compiler's version as its libraries record it (llvm.ident in each module, e.g. "Apple metal version 32023.886 (metalfe-32023.886.1)")
+static NSString *front_end(id<MTLDevice> dev) {
+    NSString *out = [NSTemporaryDirectory() stringByAppendingPathComponent:[NSString stringWithFormat:@"dmsh_rtc-%d.metallib", getpid()]];
+    NSString *why = compile_file(dev, options(), TEST, out);
+    if (why) { fprintf(stderr, "dmsh_rtc: %s\n", one_line(why).UTF8String); return nil; }
+    NSData *d = [NSData dataWithContentsOfFile:out]; unlink(out.fileSystemRepresentation);
+    NSString *s = [[NSString alloc] initWithData:d encoding:NSISOLatin1StringEncoding];
+    NSRegularExpression *re = [NSRegularExpression regularExpressionWithPattern:@"Apple metal version [0-9.]+ \\(metalfe-[0-9.]+\\)" options:0 error:nil];
+    NSTextCheckingResult *m = s ? [re firstMatchInString:s options:0 range:NSMakeRange(0, s.length)] : nil;
+    return m ? [s substringWithRange:m.range] : @"Apple metal version unknown";
+}
+
+static int serve(id<MTLDevice> dev, int jobs) {
+    MTLCompileOptions *opts = options();
+    dispatch_semaphore_t slots = dispatch_semaphore_create(jobs);
+    dispatch_group_t all = dispatch_group_create();
+    dispatch_queue_t q = dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0);
+    NSObject *out_lock = [NSObject new];
+    char *line = NULL; size_t cap = 0; ssize_t n;
+    while ((n = getline(&line, &cap, stdin)) > 0) {
+        if (line[n - 1] == '\n') line[--n] = 0;
+        NSArray<NSString *> *f = [@(line) componentsSeparatedByString:@"\t"];
+        if (f.count != 3) { @synchronized (out_lock) { printf("%s\terror\tnot <id> TAB <MSL file> TAB <library file>\n", f.firstObject.UTF8String ?: ""); fflush(stdout); } continue; }
+        dispatch_semaphore_wait(slots, DISPATCH_TIME_FOREVER);
+        dispatch_group_async(all, q, ^{ @autoreleasepool {
+            NSError *e = nil; CFAbsoluteTime t0 = CFAbsoluteTimeGetCurrent();
+            NSString *src = [NSString stringWithContentsOfFile:f[1] encoding:NSUTF8StringEncoding error:&e];
+            NSString *why = src ? compile_file(dev, opts, src, f[2]) : [NSString stringWithFormat:@"cannot read %@: %@", f[1], e.localizedDescription];
+            double ms = (CFAbsoluteTimeGetCurrent() - t0) * 1e3;
+            @synchronized (out_lock) {
+                if (why) printf("%s\terror\t%s\n", f[0].UTF8String, one_line(why).UTF8String);
+                else printf("%s\tok\t%.1f\n", f[0].UTF8String, ms);
+                fflush(stdout);
+            }
+            dispatch_semaphore_signal(slots);
+        }});
+    }
+    dispatch_group_wait(all, DISPATCH_TIME_FOREVER);
+    free(line);
+    return 0;
+}
+
+int main(int argc, char **argv) {
+    @autoreleasepool {
+        if (argc < 2) { fprintf(stderr, "usage: dmsh_rtc --version | --arch | --check | --serve [jobs]\n"); return 2; }
+        id<MTLDevice> dev = MTLCreateSystemDefaultDevice();
+        if (!dev) { fprintf(stderr, "dmsh_rtc: no Metal device\n"); return 1; }
+        if (!strcmp(argv[1], "--arch")) { printf("%s\n", dev.architecture.name.UTF8String); return 0; }
+        if (!has_calls()) { fprintf(stderr, "dmsh_rtc: this macOS's Metal has no way to pass compiler arguments or to write a compiled library (additionalCompilerArguments, serializeToURL)\n"); return 1; }
+        if (!strcmp(argv[1], "--version") || !strcmp(argv[1], "--check")) {
+            NSString *fe = front_end(dev);
+            if (!fe) return 1;
+            if (!strcmp(argv[1], "--version")) {
+                NSOperatingSystemVersion v = NSProcessInfo.processInfo.operatingSystemVersion;
+                NSString *build = [NSDictionary dictionaryWithContentsOfFile:@"/System/Library/CoreServices/SystemVersion.plist"][@"ProductBuildVersion"] ?: @"?";
+                printf("macOS %ld.%ld.%ld (%s) %s\n", (long)v.majorVersion, (long)v.minorVersion, (long)v.patchVersion, build.UTF8String, fe.UTF8String);
+            }
+            return 0;
+        }
+        if (!strcmp(argv[1], "--serve")) {
+            int jobs = argc > 2 ? atoi(argv[2]) : 0;
+            if (jobs <= 0) jobs = (int)NSProcessInfo.processInfo.activeProcessorCount;
+            return serve(dev, jobs);
+        }
+        fprintf(stderr, "dmsh_rtc: unknown option %s\n", argv[1]);
+        return 2;
+    }
+}
diff --git a/dm/gfx/tools/dmsh_rtc.py b/dm/gfx/tools/dmsh_rtc.py
new file mode 100644
index 00000000..df2f2146
--- /dev/null
+++ b/dm/gfx/tools/dmsh_rtc.py
@@ -0,0 +1,157 @@
+#!/usr/bin/env python3
+# The Mac shader libraries' Metal compile without Xcode (DMSH_METAL=runtime): macOS's own run-time compiler, the one every Metal app compiles source with, through dmsh_rtc
+# (dmsh_rtc.m: one process for the whole build, compiling as many shaders at once as the Mac has cores), with the offline compile's options (-O1, -fwrapv, the bracket depth,
+# invariance, no value names). Its libraries are rewritten here into the layout Xcode's metallib tool writes (canonical), so the host, dmsh_side.cut and the library image take them
+# as they take an Xcode build's.
+# The code is the same as an Xcode build's within the compilers' versions: Ocarina of Time's shaders (432 spread over the 42,848) compiled to the same LLVM code as Xcode 27.1's, but for
+# the order of a few loads around a discard where the compilers' versions differ (macOS 26.7's front end is metalfe-32023.886, Xcode 27.1's 32023.921), and to the same functions,
+# function types and vertex attributes. What differs in the run-time compiler's own file: each function's reflection (RFLT, and the HDYN, RLST and UUID blocks of the extended header
+# with their data after the code), and the metadata entries' sizes, which count their own size field. canonical drops the first and rewrites the second; Metal reads both forms.
+# The libraries are as deterministic as the offline compile's (a source compiles to the same bytes; dmsh_mtlcache.py keys its compile cache by the source), and the compiler's identity
+# (compiler_id: macOS's version and build and the front end's version) keys the caches, so a macOS update compiles again what it would compile differently.
+# Not part of the chain version, as dmsh_pch.py and dmsh_mtlcache.py: it changes no shader's MSL, and the libraries' cache keys carry RECORD and the compiler's identity.
+# Environment: DMSH_METAL=runtime selects it (dmsh_build.py, dmsh_mtlcache.py, tool_lock.py, the NSP script's --no-xcode), DMSH_RTC=the tool (default dmsh_rtc_bin/dmsh_rtc beside this file,
+# built by dmsh_rtc.sh), DMSH_RTC_JOBS=compiles at once (default: the cores)
+# Usage: dmsh_rtc.py --version | --arch | --check      as the tool's
+#        dmsh_rtc.py <library> <out>                     rewrite a library the run-time compiler wrote into the offline layout (canonical)
+import itertools, os, re, struct, subprocess, sys, threading
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+RUNTIME = os.environ.get('DMSH_METAL') == 'runtime'
+TOOL = os.environ.get('DMSH_RTC') or os.path.join(HERE, 'dmsh_rtc_bin', 'dmsh_rtc')
+ARGS = '-O1 -fwrapv -fbracket-depth 1024 -discard-value-names'   # dmsh_rtc.m ARGS
+RECORD = f'macOS run-time compiler: newLibraryWithSource, preserveInvariance, {ARGS}; serializeToURL, dmsh_rtc.canonical'   # in each library's reflection (chain_metal), as MAC_RECORD
+# The OoT Online blend helper's reference parameter (dmsh_pch.py _BLEND_REF): macOS 26.7's run-time compiler, like Xcode 27.1's, wants its address space written out
+_BLEND_REF = re.compile(rb'(void dm_blend\d+\()(main\w*_out& )')
+
+
+def _tool(*args):
+    r = subprocess.run([TOOL, *args], capture_output=True, text=True, errors='replace')
+    if r.returncode: raise OSError(f'{TOOL} {" ".join(args)}: {(r.stderr.strip() or r.stdout.strip() or f"exit code {r.returncode}").splitlines()[-1]}')
+    return r.stdout.strip()
+
+
+_ident = None
+def compiler_id():   # 'macOS 26.7.2 (25G332) Apple metal version 32023.886 (metalfe-32023.886.1)', once per process
+    global _ident
+    if _ident is None: _ident = _tool('--version')
+    return _ident
+
+
+def front_end():   # the front end's version as metal --version's first line names it (tool_lock.py, own_compilers.py): 'Apple metal version 32023.886 (metalfe-32023.886.1)'
+    m = re.search(r'Apple metal version .*', compiler_id())
+    return m[0] if m else compiler_id()
+
+
+def gpu_arch(): return _tool('--arch')   # applegpu_g17s
+def check(): _tool('--check')   # raises OSError with the reason when this Mac cannot compile and write a library
+
+
+class _Server:
+    """One dmsh_rtc --serve for the process: requests go in from any thread, each answer wakes the thread that asked"""
+    def __init__(self):
+        jobs = os.environ.get('DMSH_RTC_JOBS') or str(os.cpu_count() or 8)
+        self.p = subprocess.Popen([TOOL, '--serve', jobs], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, errors='replace', bufsize=1)
+        self.lock, self.wait, self.ids = threading.Lock(), {}, itertools.count()
+        threading.Thread(target=self._read, daemon=True).start()
+
+    def _read(self):
+        for line in self.p.stdout:
+            rid, _, rest = line.rstrip('\n').partition('\t')
+            with self.lock: slot = self.wait.pop(rid, None)
+            if slot: slot[1] = rest; slot[0].set()
+        with self.lock:   # the tool ended: every request still waiting fails
+            for slot in self.wait.values(): slot[1] = f'error\tthe compile tool stopped (exit code {self.p.wait()})'; slot[0].set()
+            self.wait.clear()
+
+    def ask(self, msl, lib):
+        rid, slot = str(next(self.ids)), [threading.Event(), None]
+        with self.lock:
+            if self.p.poll() is not None: return f'error\tthe compile tool stopped (exit code {self.p.returncode})'
+            self.wait[rid] = slot
+            self.p.stdin.write(f'{rid}\t{msl}\t{lib}\n'); self.p.stdin.flush()
+        slot[0].wait()
+        return slot[1]
+
+
+_server, _server_lock = None, threading.Lock()
+def compile(msl, lib):
+    """msl → the library lib, as dmsh_build.py's mac_compile: raises CalledProcessError when it does not compile (its messages on standard error, as the offline compile's)"""
+    global _server
+    with _server_lock:
+        if _server is None or _server.p.poll() is not None: _server = _Server()
+    with open(msl, 'rb') as f: src = f.read()
+    tmp = f'{lib}.rtc-{os.getpid()}-{threading.get_ident()}'
+    use = msl
+    if _BLEND_REF.search(src):
+        use = tmp + '.metal'
+        with open(use, 'wb') as f: f.write(_BLEND_REF.sub(rb'\1thread \2', src))
+    try:
+        status, _, why = _server.ask(use, tmp).partition('\t')
+        if status != 'ok':
+            print(f'{msl}: does not compile (macOS run-time compiler): {why}', file=sys.stderr, flush=True)
+            raise subprocess.CalledProcessError(1, [TOOL, '--serve'], stderr=why.encode())
+        with open(tmp, 'rb') as f: data = canonical(f.read())
+        part = lib + '.part'
+        with open(part, 'wb') as f: f.write(data)
+        os.replace(part, lib)
+    finally:
+        for p in (tmp, tmp + '.metal'):
+            try: os.unlink(p)
+            except FileNotFoundError: pass
+
+
+def _tags(b, p, end):   # a tag list (4-byte tag, 2-byte size, value) up to ENDT
+    out = []
+    while p + 4 <= end:
+        tag = b[p:p + 4]; p += 4
+        if tag == b'ENDT': return out, p
+        n = struct.unpack_from('<H', b, p)[0]; p += 2; out.append((tag, b[p:p + n])); p += n
+    raise ValueError('a tag list without its end')
+
+
+def canonical(lib):
+    """A library the run-time compiler wrote, in the offline layout: the function list without RFLT, an extended header of ENDT alone, metadata entries sized without their size field,
+    and nothing after the code. Raises ValueError on a file it does not know. A library already in that layout comes back unchanged"""
+    try:
+        if lib[:4] != b'MTLB' or struct.unpack_from('<Q', lib, 0x10)[0] != len(lib): raise ValueError('not a whole Metal library')
+        fo, fs, po, ps, qo, qs, bo, bs = struct.unpack_from('<QQQQQQQQ', lib, 0x18)
+        if fo != 0x58 or fo + 4 + fs > po or po + ps > qo or qo + qs > bo or bo + bs > len(lib): raise ValueError('sections out of order')   # fs: the list without its count
+        n = struct.unpack_from('<I', lib, fo)[0]; p = fo + 4; ents = []
+        for _ in range(n):
+            size = struct.unpack_from('<I', lib, p)[0]
+            tags, _ = _tags(lib, p + 4, p + size)
+            if not any(t == b'NAME' for t, _ in tags): raise ValueError('a function without a name')
+            body = b''.join(t + struct.pack('<H', len(v)) + v for t, v in tags if t != b'RFLT') + b'ENDT'
+            ents.append(struct.pack('<I', len(body) + 4) + body); p += size
+        if p != fo + 4 + fs: raise ValueError('the function list is not its section')
+        _tags(lib, p, po)   # the extended header (HDYN, RLST, UUID: ranges past the code), left out
+
+        def meta(o, s):   # [u32 size][tags ... ENDT] each: the size counting itself (the run-time compiler's) or not (metallib's)
+            out, q = bytearray(), o
+            while q < o + s:
+                size = struct.unpack_from('<I', lib, q)[0]
+                _, end = _tags(lib, q + 4, o + s)
+                if end - q not in (size, size + 4): raise ValueError('a metadata entry whose size is neither form')
+                out += struct.pack('<I', end - q - 4) + lib[q + 4:end]; q = end
+            return bytes(out)
+        pub, priv = meta(po, ps), meta(qo, qs)
+    except (struct.error, IndexError) as e: raise ValueError(f'an unreadable library ({e})') from e
+    listing = struct.pack('<I', n) + b''.join(ents)
+    npo = 0x58 + len(listing) + 4; nqo = npo + len(pub); nbo = nqo + len(priv)
+    head = bytearray(lib[:0x58])
+    struct.pack_into('<Q', head, 0x10, nbo + bs)
+    struct.pack_into('<QQQQQQQQ', head, 0x18, 0x58, len(listing) - 4, npo, len(pub), nqo, len(priv), nbo, bs)
+    return bytes(head) + listing + b'ENDT' + pub + priv + lib[bo:bo + bs]
+
+
+if __name__ == '__main__':
+    a = sys.argv[1:]
+    try:
+        if a in (['--version'], ['--arch']): print(_tool(*a))
+        elif a == ['--check']: check(); print('ok')
+        elif len(a) == 2:
+            with open(a[0], 'rb') as f: data = canonical(f.read())
+            with open(a[1], 'wb') as f: f.write(data)
+        else: sys.exit('usage: dmsh_rtc.py --version | --arch | --check | <library> <out>')
+    except (OSError, ValueError) as e: sys.exit(f'[RED] {e}')
